{
  "name": "altered-tcg",
  "version": "0.1.0",
  "description": "Vue 3 component and framework-agnostic renderer for Altered TCG cards",
  "type": "module",
  "main": "./dist/altered-tcg.umd.cjs",
  "module": "./dist/altered-tcg.js",
  "exports": {
    ".": {
      "import": "./dist/altered-tcg.js",
      "require": "./dist/altered-tcg.umd.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "keywords": [
    "altered",
    "tcg",
    "card",
    "renderer",
    "vue",
    "vue3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeoffreyCasaubon/altered-tcg.git"
  }
}
